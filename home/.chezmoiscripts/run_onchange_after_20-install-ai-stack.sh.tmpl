{{- $installPi := true -}}
{{- if hasKey . "installPi" -}}
{{-   $installPi = .installPi -}}
{{- end -}}
{{- $installPiWebUi := $installPi -}}
{{- if hasKey . "installPiWebUi" -}}
{{-   $installPiWebUi = and $installPi .installPiWebUi -}}
{{- end -}}
{{- $installOhMyPi := false -}}
{{- if hasKey . "installOhMyPi" -}}
{{-   $installOhMyPi = .installOhMyPi -}}
{{- end -}}
#!/bin/sh
# Tools: {{ includeTemplate "dot_config/mise/conf.d/ai-tools.toml.tmpl" . | sha256sum }}
# Pi packages: {{ include "dot_config/ai-stack/pi-packages.txt" | sha256sum }}
# Selection: pi={{ $installPi }}, pi-web-ui={{ $installPiWebUi }}, oh-my-pi={{ $installOhMyPi }}
set -eu

export PATH="$HOME/.local/bin:$PATH"

{{ if or $installPi $installPiWebUi $installOhMyPi -}}
if ! command -v mise >/dev/null 2>&1; then
    if [ "{{ .chezmoi.os }}" = "linux" ]; then
        curl -fsSL https://mise.run | sh
        export PATH="$HOME/.local/bin:$PATH"
    else
        echo "mise was not installed by Homebrew; run chezmoi apply again." >&2
        exit 1
    fi
fi

mise install --yes

{{ if $installPi -}}
while IFS= read -r package; do
    case "$package" in
        ''|'#'*) continue ;;
    esac
    mise exec -- pi install "$package"
done < "$HOME/.config/ai-stack/pi-packages.txt"
{{ end -}}

{{ if $installPiWebUi -}}
# Install only plugin code. Its API key, endpoint, model, and microphone choices
# remain in ~/.pi-web and are intentionally outside chezmoi.
mise exec -- pi-web-ui install \
    https://github.com/xing-shuyin/pi-web-ui/tree/v0.94.1/plugins/voice-input \
    --force
{{ end -}}
{{ else -}}
echo "No AI applications selected; nothing to install."
{{ end -}}
